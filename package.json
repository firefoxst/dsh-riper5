{
  "name": "dsh-riper5",
  "version": "0.7.0",
  "description": "RIPER-5 session state machine for DeepSeek Harness: storage-backed modes, a tool guard, a sandbox gate, and an approval/review protocol.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./protocol": "./lib/protocol.js",
    "./review": "./lib/review.js",
    "./state": "./lib/state.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "test",
    "tools",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "riper",
    "session",
    "workflow"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  }
}
